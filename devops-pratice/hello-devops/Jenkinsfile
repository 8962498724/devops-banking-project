
pipeline {
    agent any

    environment {
        JAVA_HOME = '/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home'
        PATH = "/opt/homebrew/opt/openjdk@17/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Code is checked out from GitHub by Jenkins'
            }
        }

        stage('Check Java and Maven') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build') {
            steps {
                dir('devops-pratice/hello-devops') {
                    sh 'mvn clean package'
                }
            }
        }
    }
}

