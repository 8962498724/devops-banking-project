
pipeline {
    agent any

    environment {
        JAVA_HOME = '/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home'
        PATH = "/opt/homebrew/opt/openjdk@17/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
    }

    stages {
        stage('Check Tools') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
                sh 'docker --version'
            }
        }

        stage('Build Java App') {
            steps {
                dir('devops-pratice/hello-devops') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('devops-pratice/hello-devops') {
                    sh 'docker build --no-cache -t hello-devops:latest .'
                }
            }

        }


        stage('Test Docker Container') {
            steps {
                dir('devops-pratice/hello-devops') {
                    sh '''
                        OUTPUT=$(docker run --rm hello-devops:latest)
                        echo "Application output: $OUTPUT"
                        test "$OUTPUT" = "Hello World!"
                    '''
                }
            }
        }
    }
}

